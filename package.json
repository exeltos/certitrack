{
  "name": "certitrack",
  "version": "2.0.0",
  "description": "CertiTrack organization certificate compliance platform",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-pages.mts && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "bash scripts/test-db.sh",
    "test:e2e": "node tests/e2e/demo-flows.mts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "^4.1.11"
  },
  "private": true,
  "type": "module"
}
