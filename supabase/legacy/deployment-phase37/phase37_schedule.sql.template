-- Phase 37 deployment template — DO NOT RUN AS-IS.
-- Replace placeholders only during controlled deployment.
-- The Edge Function is invoked daily at 08:00 UTC (11:00 Greece during EEST, 10:00 during EET).
-- We can change this schedule before production.

-- Store the project URL and a random CRON_SECRET in Vault.
select vault.create_secret('__SUPABASE_PROJECT_URL__', 'certitrack_project_url');
select vault.create_secret('__RANDOM_CRON_SECRET__', 'certitrack_cron_secret');

-- Remove a prior job with the same name if redeploying.
select cron.unschedule(jobid)
from cron.job
where jobname='certitrack-daily-notifications';

select cron.schedule(
  'certitrack-daily-notifications',
  '0 8 * * *',
  $$
  select net.http_post(
    url := (select decrypted_secret from vault.decrypted_secrets where name='certitrack_project_url')
           || '/functions/v1/process-notifications',
    headers := jsonb_build_object(
      'Content-Type','application/json',
      'x-cron-secret',(select decrypted_secret from vault.decrypted_secrets where name='certitrack_cron_secret')
    ),
    body := jsonb_build_object('scheduled_at',now())
  );
  $$
);
